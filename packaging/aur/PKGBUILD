# Maintainer: Anton Schahlou <anton dot shheglov dot 1 at gmail dot com>
pkgname=ani-sync
pkgver=0.1.0
pkgrel=1
pkgdesc="Vim-style TUI that plays anime with ani-cli and tracks progress on AniList"
arch=('any')
url="https://github.com/GITHUB_USER/ani-sync"
license=('GPL-3.0-or-later')
depends=('bash' 'ani-cli' 'mpv' 'curl' 'jq' 'gawk' 'coreutils' 'sed' 'grep')
optdepends=('xdg-utils: open the AniList login page in your browser')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

check() {
    cd "$pkgname-$pkgver"
    make check
}

package() {
    cd "$pkgname-$pkgver"
    make DESTDIR="$pkgdir" PREFIX=/usr install
}
